
const express = require("express");
const OpenAI = require("openai");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json({ limit: "1mb" }));
app.use(express.static("public"));

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

app.get("/api/status", (req, res) => {
  res.json({
    status: "online",
    name: "Luna AI"
  });
});

app.post("/api/chat", async (req, res) => {
  try {
    const { messages, character } = req.body;

    if (!Array.isArray(messages) || messages.length === 0) {
      return res.status(400).json({
        error: "Сообщения не найдены"
      });
    }

    const safeMessages = messages
      .filter(m =>
        m &&
        ["user", "assistant"].includes(m.role) &&
        typeof m.content === "string"
      )
      .slice(-30);

    const response = await client.chat.completions.create({
      model: "gpt-4o-mini",
      messages: [
        {
          role: "system",
          content: `Ты Luna AI — умный, доброжелательный
          собеседник и помощник для ролевых историй.
          Поддерживай последовательность сюжета,
          характеры персонажей и контекст диалога.
          Пиши естественно, выразительно и интересно.
          Уважай пользователя и соблюдай безопасные
          возрастные границы.
          ${typeof character === "string"
            ? "Описание персонажа: " + character.slice(0, 2000)
            : ""}
          `
        },
        ...safeMessages
      ],
      temperature: 0.85,
      max_tokens: 1200
    });

    res.json({
      reply: response.choices[0].message.content
    });

  } catch (error) {
    console.error("Luna error:", error.message);

    res.status(500).json({
      error: "Не удалось получить ответ от Luna AI"
    });
  }
});

app.listen(PORT, () => {
  console.log(`Luna AI running on port ${PORT}`);
});
